# Copy to .env. With every flag false, ClaimShield runs fully locally.

# Explicit local demo only; rejects non-loopback requests and Cloud Run.
# Production requires iap plus all three settings below. See README authentication.
CLAIMSHIELD_AUTH_MODE=demo
CLAIMSHIELD_IAP_AUDIENCE=
CLAIMSHIELD_PUBLIC_ORIGIN=
# JSON mapping verified IAP sub values to tenant IDs; managed by the operator.
CLAIMSHIELD_AUTH_MEMBERSHIPS={}
# Comma-separated verified IAP subject IDs allowed into the insurer review workspace.
CLAIMSHIELD_REVIEWER_SUBJECTS=
# Comma-separated verified IAP subject IDs allowed to ingest/review IRDAI references.
CLAIMSHIELD_REGULATORY_ADMIN_SUBJECTS=

# --- Google Cloud project ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Document AI (Form Parser processor) ---
CLAIMSHIELD_USE_DOCAI=false
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# --- BigQuery ---
CLAIMSHIELD_USE_BIGQUERY=false
BQ_DATASET=claimshield

# --- Vertex AI Search (Discovery Engine data store with the sample policies) ---
CLAIMSHIELD_USE_VERTEX_SEARCH=false
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATASTORE_ID=claimshield-policies

# --- Gemini on Vertex AI ---
CLAIMSHIELD_USE_GEMINI=false
GEMINI_MODEL=gemini-2.5-flash

# --- Cloud Storage (uploads + generated reports) ---
CLAIMSHIELD_USE_GCS=false
GCS_BUCKET=

# --- Behaviour ---
CLAIMSHIELD_USE_ADK=true
# Flag unit prices above this multiple of the 90th-percentile benchmark
CLAIMSHIELD_OUTLIER_RATIO=1.3
# Seconds to pause after each trace step so the live trace is readable in local mode (0 = off)
CLAIMSHIELD_DEMO_PACE=0.35

# Guided review queue: local workers or Cloud Tasks.
CLAIMSHIELD_WORKERS=2
CLAIMSHIELD_QUEUE_CAPACITY=100
CLAIMSHIELD_USER_PENDING_LIMIT=3

# Asynchronous processing on Cloud Run:
# Set to false to use Cloud Run background workers with always-allocated CPU (--no-cpu-throttling).
CLAIMSHIELD_USE_CLOUD_TASKS=false
CLOUD_TASKS_QUEUE=
# Shared secret for internal Cloud Tasks / worker dispatch (leave empty in local demo mode)
CLAIMSHIELD_INTERNAL_TOKEN=
